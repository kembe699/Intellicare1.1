# ─────────────────────────────────────────────────────────────
#  IntelliCare HMIS — Environment Configuration
#  Copy this file to .env and adjust values as needed.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Database (used by docker-compose) ─────────────────────────
DB_NAME=intellicare_hmis
DB_USER=hmis_user
DB_PASSWORD=hmis_pass

# ── Analytics Assistant read-only DB role (optional, defense-in-depth) ──
# Off by default. When set, a dedicated Postgres role (SELECT-only — no
# INSERT/UPDATE/DELETE/DDL, ever) is created automatically and granted
# access to each tenant schema, and the chatbot's queries run through it
# instead of the app's normal full-access connection. See
# src/server/config/ensureAnalyticsReadOnlyRole.js for how it's provisioned
# and tenantDb.js's getReadOnlyTenantConnection for how it's used — this is
# a second, independent layer on top of the application-level permission
# checks already in llmTools.js, not a replacement for them.
DB_READONLY_PASSWORD=
DB_READONLY_POOL_MAX=3

# ── App Port (host-side, default 3002) ────────────────────────
APP_PORT=3002

# ── Security (CHANGE THESE in production!) ────────────────────
JWT_SECRET=intellicare_jwt_secret_change_in_production
SESSION_SECRET=intellicare_session_secret_change_in_production

# ── CORS (set to your server IP/domain in production) ─────────
CORS_ORIGIN=*

# ── Email (password resets, new-user credentials, tenant welcome) ──
# Without RESEND_API_KEY (preferred — works even where outbound SMTP ports
# are blocked, e.g. Render's free tier) or the SMTP pair below, emails are
# just logged to the console instead of sent — the feature still works, the
# message just never reaches anyone.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=IntelliCare
SUPPORT_EMAIL=support@nilehc.tech
FRONTEND_URL=http://localhost:8080
# SMTP fallback, only used when RESEND_API_KEY is not set
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ── Anthropic (shared by every AI-backed feature below) ────────
# One key, one client (src/server/services/ai/anthropicClient.js), used by
# both Clinical Insights and the Analytics Assistant's LLM mode.
ANTHROPIC_API_KEY=
# Default model for any caller that doesn't set its own feature-specific
# override (CLINICAL_INSIGHTS_MODEL, ANALYTICS_CHATBOT_MODEL below).
ANTHROPIC_MODEL=claude-sonnet-5-5
# Per-request timeout in milliseconds.
ANTHROPIC_TIMEOUT_MS=60000

# ── Clinical Insights (AI decision-support panel) ──────────────
# Off by default — flip to true per environment once ANTHROPIC_API_KEY is set.
CLINICAL_INSIGHTS_ENABLED=false
CLINICAL_INSIGHTS_MODEL=claude-sonnet-5-5
# Returns canned sample output instead of calling the real API — for local
# testing only; ignored (forced off) whenever NODE_ENV=production.
CLINICAL_INSIGHTS_MOCK=false

# ── Analytics Assistant LLM mode (conversational chatbot) ───────
# Off by default — falls back to the deterministic keyword engine until set.
ANALYTICS_CHATBOT_LLM_ENABLED=false
ANALYTICS_CHATBOT_MODEL=claude-opus-5-5
# Mock mode for local testing, same semantics as CLINICAL_INSIGHTS_MOCK —
# ignored (forced off) whenever NODE_ENV=production.
ANALYTICS_CHATBOT_MOCK=false

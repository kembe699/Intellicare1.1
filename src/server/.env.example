# ── PostgreSQL connection ────────────────────────────────────────────────────
# (Migrated from MySQL — see scripts/mysql2pg.py and POSTGRES_MIGRATION.md)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=intellicare
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Managed Postgres (Render, Supabase, …) terminates TLS; a local container
# usually does not. Set to true/require to enable SSL.
DB_SSL=false

# ── Multi-tenant control plane ───────────────────────────────────────────────
# Holds only the SaaS layer (clients, plans, invoices). Each tenant's hospital
# data lives in its own database named TENANT_DB_PREFIX + <client code>.
PLATFORM_DB_NAME=intellicare_platform
TENANT_DB_PREFIX=intellicare_client_

# ── App ──────────────────────────────────────────────────────────────────────
# Use a long random string; this signs every session token.
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com
PORT=3002
REDIS_ENABLED=false

# ── Optional: seed a first admin account on boot ─────────────────────────────
# Left unset, no default admin is created. Never commit a real value.
# SEED_ADMIN_PASSWORD=

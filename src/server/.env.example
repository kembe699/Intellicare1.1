# ── PostgreSQL connection ────────────────────────────────────────────────────
# (Migrated from MySQL — see scripts/mysql2pg.py and POSTGRES_MIGRATION.md)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=intellicare
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Managed Postgres (Render, Supabase, …) terminates TLS; a local container
# usually does not. Set to true/require to enable SSL.
DB_SSL=false

# ── Multi-tenancy (ONE database, isolated by schema) ─────────────────────────
# The control plane (clients, plans, invoices) lives in `public`. Each tenant
# gets its own schema, TENANT_SCHEMA_PREFIX + <client code>, cloned from the
# template. Creating a schema needs no special privilege, so new clients can be
# provisioned from /platform-admin on managed Postgres (Render, Neon, Supabase).
PLATFORM_SCHEMA=public
TENANT_SCHEMA_PREFIX=tenant_
TENANT_TEMPLATE_SCHEMA=tenant_template

# Reference tables copied from the template into each new tenant. Add a
# catalogue here (or just insert it into the template) to have every future
# tenant start with it.
# TENANT_SEED_TABLES=clinic_names,currencies,roles,privileges,role_privileges,lab_test_categories,chief_complaints

# Connections are pooled per active tenant against one database, so this caps
# each tenant's share of the instance connection limit.
DB_POOL_MAX=5

# ── App ──────────────────────────────────────────────────────────────────────
# Use a long random string; this signs every session token.
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com
PORT=3002
REDIS_ENABLED=false

# ── Optional: seed a first admin account on boot ─────────────────────────────
# Left unset, no default admin is created. Never commit a real value.
# SEED_ADMIN_PASSWORD=

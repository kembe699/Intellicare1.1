# Local PostgreSQL Database Configuration
# Copy this to .env for local development

# Local PostgreSQL Database
DATABASE_URL=postgresql://intellicare_user:intellicare2024@localhost:5432/intellicare_hmis
DB_HOST=localhost
DB_PORT=5432
DB_NAME=intellicare_hmis
DB_USER=intellicare_user
DB_PASSWORD=intellicare2024

# JWT Configuration
JWT_SECRET=your-secret-key-minimum-32-characters-change-this

# Server Configuration
PORT=3002
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Session Configuration
SESSION_SECRET=your-session-secret-key-change-this-in-production

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Email Configuration (if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Logging Configuration
LOG_LEVEL=info

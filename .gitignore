# Catches production.env and src/server/production.env — these carry real DB
# credentials and the JWT signing secret, confirmed untracked but previously
# unmatched by any pattern above (no leading dot, and .env.production doesn't
# glob-match a file literally named production.env).
production.env
**/production.env


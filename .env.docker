# Docker environment variables
# Copy this file to .env and fill in your values before running docker-compose
# cp .env.docker .env

# ─── App ──────────────────────────────────────────────────────────────────────
# Port the app is exposed on the HOST (container always uses 3002 internally)
APP_PORT=3002

# ─── Database ─────────────────────────────────────────────────────────────────
DB_NAME=intellicare_hmis
DB_USER=hmis_user
DB_PASSWORD=hmis_pass

# ─── Security ─────────────────────────────────────────────────────────────────
# CHANGE BOTH of these to long random strings in production!
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production
SESSION_SECRET=change_this_session_secret_to_a_long_random_string

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set to your domain in production (e.g. https://your-domain.com)
# Use * only for local dev/testing
CORS_ORIGIN=*

# ─── Redis cache (optional) ───────────────────────────────────────────────────
# Leave REDIS_ENABLED=false to use in-memory cache (default, no extra setup)
# Set REDIS_ENABLED=true and provide REDIS_URL to use Redis (e.g. Upstash)
REDIS_ENABLED=false
REDIS_URL=
